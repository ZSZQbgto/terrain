{
  "name": "terrain-viewer",
  "version": "1.0.0",
  "description": "8 km DEM 三维地形浏览器 + 地形沙盘模型编辑器：卫星瓦片 LOD、glb 模型编辑、标签、GPU 浅水模拟与工程导入导出",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "assets": "node scripts/prepare-assets.mjs",
    "assets:check": "node scripts/ensure-assets.mjs",
    "postbuild": "node scripts/ensure-assets.mjs --dist",
    "models:index": "node scripts/build-model-index.mjs",
    "models:sample": "node scripts/make-sample-glb.mjs"
  },
  "keywords": [
    "three.js",
    "terrain",
    "dem",
    "model-editor",
    "water-simulation"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^7.3.7"
  }
}
